{
  "name": "torneos-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "node scripts/run-local.mjs migrate",
    "db:seed": "node scripts/run-local.mjs seed",
    "demo:ready": "node scripts/run-local.mjs seed-ready",
    "demo:journeys": "node scripts/run-local.mjs seed-journeys",
    "demo:finished": "node scripts/run-local.mjs seed-finished",
    "demo:verify": "node scripts/run-local.mjs verify-finished",
    "dev": "node scripts/run-local.mjs dev",
    "dev:api": "node scripts/run-local.mjs api",
    "dev:web": "node scripts/run-local.mjs web",
    "preview:pwa": "node scripts/run-local.mjs preview-pwa",
    "typecheck": "node scripts/run-local.mjs typecheck",
    "build": "node scripts/run-local.mjs build",
    "test": "node scripts/run-local.mjs test",
    "backup": "node scripts/run-local.mjs backup",
    "restore:check": "node scripts/run-local.mjs restore-check",
    "perf:check": "node scripts/run-local.mjs perf-check",
    "perf:load": "node scripts/run-local.mjs perf-load",
    "perf:scenario": "node scripts/run-local.mjs perf-scenario",
    "audit:routes": "node scripts/run-local.mjs audit-routes",
    "ops:check": "node scripts/run-local.mjs ops-check",
    "worker:once": "node scripts/run-local.mjs worker",
    "preview:visual": "node scripts/ver-prototipo.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
